{
  "name": "structurizr-dsl",
  "displayName": "Structurizr DSL",
  "description": "Structurizr DSL language support: syntax highlighting, diagnostics, outline, hover, completion, diagram preview and export to SVG, PlantUML and Mermaid",
  "version": "0.2.3",
  "publisher": "local",
  "license": "unlicense",
  "type": "module",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:structurizr",
    "onCommand:structurizr.openPreview",
    "onCommand:structurizr.exportView",
    "onCommand:structurizr.exportAllViews"
  ],
  "contributes": {
    "languages": [
      {
        "id": "structurizr",
        "aliases": [
          "Structurizr DSL",
          "structurizr"
        ],
        "extensions": [
          ".dsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "structurizr",
        "scopeName": "source.structurizr",
        "path": "./syntaxes/structurizr.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "structurizr.openPreview",
        "title": "Structurizr: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "structurizr.exportView",
        "title": "Structurizr: Export View…"
      },
      {
        "command": "structurizr.exportAllViews",
        "title": "Structurizr: Export All Views…"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "structurizr.openPreview",
          "when": "resourceLangId == structurizr",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "structurizr.openPreview",
          "when": "editorLangId == structurizr"
        },
        {
          "command": "structurizr.exportView",
          "when": "editorLangId == structurizr || activeWebviewPanelId == structurizrPreview"
        },
        {
          "command": "structurizr.exportAllViews",
          "when": "editorLangId == structurizr || activeWebviewPanelId == structurizrPreview"
        }
      ],
      "editor/context": [
        {
          "command": "structurizr.exportView",
          "when": "editorLangId == structurizr",
          "group": "structurizr@1"
        },
        {
          "command": "structurizr.exportAllViews",
          "when": "editorLangId == structurizr",
          "group": "structurizr@2"
        }
      ]
    },
    "configuration": {
      "title": "Structurizr DSL",
      "properties": {
        "structurizr.export.defaultFormat": {
          "type": "string",
          "default": "svg",
          "enum": [
            "svg",
            "plantuml-c4",
            "plantuml-basic",
            "mermaid-flowchart",
            "mermaid-c4"
          ],
          "enumDescriptions": [
            "SVG image",
            "PlantUML using the C4-PlantUML library",
            "Plain PlantUML with explicit colours",
            "Mermaid flowchart",
            "Mermaid C4 diagram types"
          ],
          "description": "The format offered first when exporting a view."
        },
        "structurizr.export.action": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "save",
            "copy",
            "open"
          ],
          "enumDescriptions": [
            "Ask every time",
            "Save to a file",
            "Copy to the clipboard",
            "Open in a new editor"
          ],
          "description": "What to do with an exported view."
        },
        "structurizr.export.svgTheme": {
          "type": "string",
          "default": "light",
          "enum": [
            "light",
            "dark",
            "editor"
          ],
          "enumDescriptions": [
            "Light colours (best for documents)",
            "Dark colours",
            "Match the editor's current theme"
          ],
          "description": "The colour scheme of exported SVG images."
        },
        "structurizr.variables": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Constants available to `${NAME}` in every workspace, like `--define` on the command line. They override a workspace's own `!const` / `!var` of the same name; environment variables are the fallback.",
          "scope": "resource"
        },
        "structurizr.includes.allowRemote": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allow `!include https://...` to download files. Off by default: a workspace could otherwise make your editor fetch arbitrary URLs just by being opened."
        }
      }
    }
  },
  "scripts": {
    "gen:grammar": "node scripts/gen-grammar.ts",
    "build": "node scripts/build.mjs",
    "package": "node scripts/vsix.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  }
}
